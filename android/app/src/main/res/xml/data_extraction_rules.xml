<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up. Nothing goes to cloud backup, so uninstalling Focus Hub really removes
     its data: a reinstall starts fresh instead of restoring old data. (Export a backup file
     from Settings to keep your data.) Moving to a new phone with a cable or Wi-Fi transfer
     still brings the data along. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
